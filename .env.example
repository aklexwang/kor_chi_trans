# BotFather에서 발급한 봇 토큰 (따옴표 없이 한 줄로)
TELEGRAM_TOKEN=your_telegram_bot_token_here

# https://console.anthropic.com/ 에서 발급
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# 선택. 생략 시 기본값: claude-sonnet-4-6
# CLAUDE_MODEL=claude-sonnet-4-6

# 선택. 주 모델이 API에서 404일 때만 순서대로 시도(콤마 구분). 생략 시 코드에 내장된 기본 폴백 사용
# CLAUDE_MODEL_FALLBACK=claude-sonnet-4-20250514,claude-3-5-sonnet-20241022

# 선택. Anthropic API HTTP 타임아웃(초). 느린 네트워크면 read만 늘려 보기
# ANTHROPIC_READ_TIMEOUT=180
# ANTHROPIC_CONNECT_TIMEOUT=30
