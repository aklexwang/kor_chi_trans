# BotFather에서 발급한 봇 토큰 (따옴표 없이 한 줄로)
TELEGRAM_TOKEN=your_telegram_bot_token_here

# https://console.anthropic.com/ 에서 발급
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# 선택. 생략 시 기본값: claude-sonnet-4-6
# CLAUDE_MODEL=claude-sonnet-4-6

# 선택. 주 모델이 API에서 404일 때만 순서대로 시도(콤마 구분). 생략 시 코드에 내장된 기본 폴백 사용
# CLAUDE_MODEL_FALLBACK=claude-sonnet-4-20250514,claude-3-5-sonnet-20241022

# 선택. Anthropic API HTTP 타임아웃(초). 느린 네트워크면 read만 늘려 보기
# ANTHROPIC_READ_TIMEOUT=180
# ANTHROPIC_CONNECT_TIMEOUT=30

# 선택. 텔레그램 누가 쓸지 제한(콤마 구분 숫자 ID). 둘 다 비우면 누구나 사용 가능.
# @userinfobot 등으로 본 본인 user id / 그룹은 그룹 chat id(보통 음수)를 넣음.
# ALLOWED_USER_IDS=123456789,987654321
# ALLOWED_CHAT_IDS=-1001234567890
# user만 지정: 그 사용자가 어느 채팅에서내도 허용. chat만 지정: 그 방에 있는 누구나 허용.
# 둘 다 지정: 사용자 ID가 목록에 있거나 채팅 ID가 목록에 있으면 허용(OR).

# 선택. "특정 사람(@kplayone 등)이 들어가 있는 방에서만" 쓰려면 이 항목 사용.
# @username 문자열은 쓰지 말고, @userinfobot 등에서 그 계정의 숫자 user id 를 확인한 뒤 아래에 넣음.
# - 그룹/슈퍼그룹: 그 id 가 멤버로 있는 방에서만 봇이 번역함(봇이 그 그룹에 있어야 함).
# - 1:1: 그 id 본인이 봇에게 쓸 때만 허용(다른 사람 1:1 → 거절).
# REQUIRE_USER_PRESENT_ID=1303018436

# ── Google Authenticator(TOTP) — 관리자만 앱 보유, 코드를 알려준 사람만 사용 ──
# TOTP_SECRET 을 넣으면 기본으로 OTP 인증이 켜집니다(ENABLE_TOTP_AUTH=false 로 끄기).
# 시크릿은 관리자 휴대폰 Google Authenticator에만 등록하세요. 다른 사람에게 공유하지 마세요.
# 새 시크릿: python -c "import pyotp; print(pyotp.random_base32())"
# TOTP_SECRET=YOUR_BASE32_SECRET_HERE
# ENABLE_TOTP_AUTH=true
# 관리자 텔레그램 user id (@userinfobot). /authlist /revoke /revokeall 명령용
# ADMIN_USER_IDS=123456789
# 인증 유효 시간(시간). 만료 후 다시 관리자에게 코드 요청 필요. 0=만료 없음
# OTP_SESSION_HOURS=24
# OTP_VALID_WINDOW=1
# OTP_MAX_FAILURES=5
# OTP_LOCKOUT_MINUTES=15
